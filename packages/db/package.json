{
  "name": "@compliance-kit/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -p tsconfig.json",
    "postinstall": "pnpm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --config prisma.master.config.ts && prisma generate --config prisma.tenant.config.ts",
    "master:migrate": "prisma migrate deploy --config prisma.master.config.ts",
    "master:migrate:dev": "prisma migrate dev --config prisma.master.config.ts",
    "tenant:ddl": "prisma migrate diff --config prisma.tenant.config.ts --from-empty --to-schema=prisma/tenant/schema.prisma --script --output=sql/tenant-schema.sql",
    "seed:admin": "node dist/seed/seed-tenant-admin.js",
    "keys": "node dist/keys/manage-keys.js"
  },
  "dependencies": {
    "@compliance-kit/common": "workspace:*",
    "@compliance-kit/crypto": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1"
  }
}
