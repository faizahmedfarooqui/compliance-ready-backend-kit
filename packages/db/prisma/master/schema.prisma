// MASTER (control-plane) schema. Holds the tenant registry and global config.
// Contains NO tenant business data. One master database per deployment.
//
// This schema is migrated normally (`pnpm --filter @compliance-kit/db master:migrate`).
// The per-tenant data plane lives in ../tenant/schema.prisma and is applied to each
// tenant's own database at provisioning time.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/master"
  // Prisma 7 emits TypeScript that our own tsc compiles. The project is CommonJS with
  // classic node resolution, so ask for CJS and extensionless imports.
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

// Prisma 7 moved datasource URLs out of the schema; MASTER_DATABASE_URL is supplied to
// the CLI by prisma.master.config.ts, and to the client by the pg driver adapter.
datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  provisioning
  active
  suspended

  @@map("tenant_status")
}

/// A customer/company. One row here == one dedicated database on the tenant cluster.
model Tenant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  slug String @unique
  name String

  /// The dedicated database for this tenant, on the tenant cluster.
  databaseName String @unique @map("database_name")

  /// `provisioning` until the schema is applied; the completion marker for a
  /// provisioning run that cannot be wrapped in a transaction (CREATE DATABASE).
  status TenantStatus @default(provisioning)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenants")
}

enum KeyPurpose {
  token_signing
  token_encryption

  @@map("key_purpose")
}

enum KeyState {
  /// Generated, wrapped and stored. Signs nothing, verifies nothing, published nowhere.
  pending
  /// The one key that signs (or encrypts). At most one per purpose, enforced by the database.
  active
  /// No longer signs, but STILL VERIFIES until not_after. This is the rotation overlap.
  retiring
  /// Terminal. Material destroyed, row kept as evidence of what existed and when.
  revoked

  @@map("key_state")
}

/// An enum rather than free text, so adding a cipher is a migration: a reviewable change to the
/// cryptographic inventory rather than a string literal appearing in a commit.
enum KeyAlgorithm {
  ES256
  A256KW

  @@map("key_algorithm")
}

/// Deployment-wide cryptographic keys for the access-token codec.
///
/// CONTROL PLANE, AND DELIBERATELY NOT TENANT-SCOPED. Which tenant a token belongs to is the `tid`
/// claim INSIDE the ciphertext, so a per-tenant signing key would force a verifier to learn the
/// tenant before it could verify anything, and every way of doing that is broken: from the claim
/// itself is circular, from the outer JWE header leaks the tenant on every token and defeats the
/// encryption, and from the x-tenant-id header makes key selection attacker-directed. One key set
/// signs for every tenant, and there is one JWKS.
///
/// The honest cost, stated because the architecture would otherwise imply otherwise:
/// database-per-tenant isolates DATA, not this credential. Compromise the active signing key and
/// you can forge tokens for every tenant. What limits that is the key never being in a tenant
/// database, never being stored unwrapped, and ES256 meaning verifiers hold only a public key.
///
/// Stores ONLY wrapped material. A table of private keys in the same database as the data they
/// protect is not key management; it means one compromise yields both.
model ConfigKey {
  /// The `kid` from the JWS/JWE protected header, which IS the lookup key, so it is the primary
  /// key rather than a surrogate that would let two rows claim one kid.
  ///
  /// TEXT, deliberately NOT @db.Uuid, for two reasons. RFC 7517 section 4.5 makes `kid` a
  /// case-sensitive string while Postgres normalises uuid case, so a uuid column would silently
  /// match "ABC..." to "abc...". And an attacker-supplied kid that is not a uuid would raise
  /// Postgres 22P02 rather than simply not matching, turning a clean 401 into a 500 and an
  /// error-log flood. That is the same bug this repository already fixed in resolveTenant.
  kid String @id

  purpose KeyPurpose

  /// Stored so it can be CHECKED at the point of use, not inferred from the token's own header.
  /// RFC 8725 section 3.1: each key must be used with exactly one algorithm, and that must be
  /// verified when the cryptographic operation is performed.
  algorithm KeyAlgorithm

  state KeyState @default(pending)

  /// Output of KeyProvider.wrap: iv(12) || ciphertext || tag(16). NEVER plaintext. Nullable so a
  /// revoked row can keep its metadata, which is the evidence, without keeping the material, which
  /// is the liability.
  wrappedKey Bytes? @map("wrapped_key")

  /// Which key-encrypting key produced `wrappedKey` (KeyProvider.id). Without it, a deployment
  /// that has rotated or migrated KEKs cannot tell which rows it can still unwrap, and finds out
  /// during an incident.
  kekId String @map("kek_id")

  /// Public half, asymmetric keys only, served verbatim from the JWKS endpoint. NULL for symmetric
  /// keys, which have no publishable half.
  publicJwk Json? @map("public_jwk")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt DateTime? @map("activated_at") @db.Timestamptz(6)
  retiringAt  DateTime? @map("retiring_at") @db.Timestamptz(6)

  /// End of the rotation overlap: when this key stops being accepted for verification. Set on
  /// entering `retiring`, as now + access token TTL + clock tolerance. Shorter and live tokens die
  /// at rotation; absent and the overlap never ends.
  notAfter DateTime? @map("not_after") @db.Timestamptz(6)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Required when revoking. "Scheduled rotation" and "suspected compromise" are different events
  /// and an assessor will ask which one this was.
  revokedReason String? @map("revoked_reason")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([purpose, state])
  @@map("config_keys")
}

/// Deployment-wide configuration that is not tenant-specific.
model GlobalConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("global_config")
}

// ---------------------------------------------------------------------------
// Append-only audit log
//
// Present in BOTH the tenant and master schemas, with the same shape and a chain of its own in each.
// Events about a tenant's users are that tenant's data and belong in that tenant's database, which is
// also what keeps per-tenant export and deletion coherent. Control-plane events (provisioning) have no
// tenant database to go in at the time they happen, so they go to the master chain.
//
// One chain per database, never one shared chain. A shared chain would need a cross-database round trip
// on every audited write, making the master a single point of failure for all of them, and it could not
// be serialised anyway: Postgres advisory locks are per-database, so there is no lock that orders
// appends across tenants.
//
// The integrity controls are NOT expressed here, because Prisma's schema language cannot express them.
// See packages/db/sql/audit-immutability.sql, applied at provisioning, and the master migration: a trigger
// refusing UPDATE, DELETE and TRUNCATE, REVOKE on those privileges, and CHECK constraints pinning
// the hash widths, the metadata shape and the actor_type/actor_id pairing.
// ---------------------------------------------------------------------------

enum AuditActorType {
  /// An authenticated user inside the tenant. actor_id is their user id.
  user
  /// The control-plane bearer credential. It authenticates the BEARER and not a person, so actor_id
  /// is null: recording an operator identity here would imply attribution the credential cannot carry.
  control_plane
  /// The service acting on its own, e.g. a provisioning step.
  system
  /// An unauthenticated caller, e.g. a failed login. actor_id is null by definition.
  anonymous

  @@map("audit_actor_type")
}

/// One recorded event. Rows are never updated or deleted; see the immutability SQL.
model AuditEvent {
  /// Position in the chain, assigned by the database. Gaps are expected and harmless: a sequence
  /// consumes a value even when the transaction rolls back, and integrity comes from the hash links
  /// rather than from this column being contiguous.
  seq BigInt @id @default(autoincrement())

  /// Set from the database clock inside the appending transaction, not `now()` as a column default:
  /// the value has to be known while the hash is computed, so the writer reads it and passes it.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  /// Dotted and past tense, e.g. "auth.login.succeeded". Queried by prefix, so the order of the
  /// segments matters more than it looks.
  action String

  actorType AuditActorType @map("actor_type")
  /// Text rather than uuid: a control-plane or system actor has no uuid, and a future external
  /// identity may not be one either.
  actorId   String?        @map("actor_id")

  resourceType String? @map("resource_type")
  resourceId   String? @map("resource_id")

  /// Ties the event to the request that caused it, and to the server log line for the same request.
  traceId  String? @map("trace_id")
  sourceIp String? @map("source_ip")

  /// Flat map of STRING values only. See AuditMetadata in packages/crypto: jsonb rewrites numbers and
  /// reorders keys, and a hash over data the database may rewrite fails for reasons unrelated to
  /// tampering.
  metadata Json @default("{}")

  /// The previous event's hash. The genesis row carries 32 zero bytes rather than NULL, so that the
  /// unique index below can mean what it says.
  prevHash Bytes @map("prev_hash")
  hash     Bytes

  /// Exactly one event may follow any given hash, which makes a FORK impossible at the database level
  /// rather than merely unlikely. This is the second line of defence behind the advisory lock the
  /// writer takes: if that lock is ever wrong, or another code path inserts without it, two concurrent
  /// appends both reading the same head collide here and one fails, instead of both succeeding and
  /// leaving two divergent histories that each verify.
  @@unique([prevHash], map: "audit_events_prev_hash_unique")
  /// A duplicate hash would mean two identical events at the same point in history, which cannot
  /// legitimately happen and would make the chain ambiguous to walk.
  @@unique([hash], map: "audit_events_hash_unique")
  /// The common query: what happened to this thing, most recent first.
  @@index([resourceType, resourceId, seq(sort: Desc)], map: "audit_events_resource_idx")
  /// The other common query: everything of one kind in a time range.
  @@index([action, occurredAt(sort: Desc)], map: "audit_events_action_idx")
  @@map("audit_events")
}
