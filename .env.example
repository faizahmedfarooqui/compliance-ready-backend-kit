# ---------------------------------------------------------------------------
# NON-SECRET pointers only. Real credentials never live here.
# In production, secrets (DB passwords, the JWT signing key) are fetched at
# runtime from AWS KMS / Secrets Manager into typed config, never process.env.
# This file documents shape for LOCAL development only.
#
# Copy to .env at the repo root:  cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development

# The service listens here. Not 3000/3001, which collide with most dev servers.
PORT=3011

# Master (control-plane) database: tenant registry + global config.
# Ports match docker-compose.yml, which also avoids the defaults (5432/6379) so that
# `docker compose up` does not fight an existing local Postgres or Redis.
MASTER_DATABASE_URL=postgres://postgres:postgres@localhost:55432/master

# Base cluster for per-tenant databases. Each tenant gets its own database on
# this cluster; the manager appends the tenant's database name from the registry.
TENANT_CLUSTER_URL=postgres://postgres:postgres@localhost:55432

# Base URI for RFC 9457 problem `type` values; the error code is appended as a fragment.
# Dereferencing it should return documentation for the problem type, so it points at this
# repo's error catalogue. CHANGE THIS IF YOU FORK, or your API will cite someone else's docs
# for its own errors. Defaults to the upstream catalogue when unset.
PROBLEM_TYPE_BASE_URI=https://github.com/faizahmedfarooqui/compliance-ready-backend-kit/blob/main/problems.md

# Auth
JWT_ISSUER=compliance-ready-backend-kit
# Rejects a token minted for some other service that happens to share these keys.
JWT_AUDIENCE=compliance-kit-api
JWT_ACCESS_TTL_SECONDS=900
# Clock-skew leeway, and the length of a key-rotation overlap (TTL + tolerance).
JWT_CLOCK_TOLERANCE_SECONDS=5

# Access tokens are NESTED JWTs: the claims are signed (JWS with ES256), then that signed token is
# encrypted (JWE with A256KW + A256GCM).
#
# The signing and encryption keys are NOT here. They live in the `config_keys` table in the master
# database, stored wrapped by the key-encrypting key below, and are created with `pnpm keys:init`.
# That is the point of envelope encryption: a key in config is a key in every deploy manifest, CI
# secret store and developer shell, whereas one KEK can move into KMS, an HSM or an enclave without
# touching anything else.
#
# base64url-encoded 256-bit key. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# DEV ONLY placeholder, published in this file and therefore public knowledge. Never use it anywhere
# real. In production the KEK is fetched at runtime from KMS / Secrets Manager.
KEY_ENCRYPTION_KEY=devonly0000000000000000000000000000000000AA

# Bearer credential for the control plane: POST /api/tenants, which creates databases.
# REQUIRED, with no default. That route used to be unauthenticated, and an optional key would
# leave it open again whenever nobody set one, so the service refuses to start without it.
# Present it as: Authorization: Bearer <this value>
#
# DEV ONLY placeholder, published in this file and therefore public knowledge.
CONTROL_PLANE_API_KEY=devonly0000000000000000000000000000000000CP

REDIS_URL=redis://localhost:56379

# --- Rate limiting -----------------------------------------------------------
# Whether to believe X-Forwarded-For. Leave false unless a proxy you control sets it: true
# without one lets any caller send the header and get a fresh bucket per request. Left false
# BEHIND a proxy, every request looks like it comes from the proxy and all traffic shares one
# bucket, so the first busy client rate-limits everyone. Both are wrong somewhere; pick knowingly.
TRUST_PROXY=false

# Requests per client per window for routes with no stricter limit of their own.
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW_MS=60000

# Failed logins per account, and per source address, before both are throttled. Counted on
# failure only and cleared on success, so a user who mistypes and then succeeds is never closer
# to a limit. Set the window to 1800000 for a 30-minute lockout reading of PCI-DSS 8.3.4.
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_WINDOW_MS=900000

# What to do when Redis is unreachable: true serves the request unmetered, false rejects it.
# Open by default because closed turns a Redis blip into a total API outage, including login.
# Every occurrence is logged at error level so the degradation is visible rather than silent.
RATE_LIMIT_FAIL_OPEN=true

# --- HTTP limits -------------------------------------------------------------
# Denial-of-service controls, not tuning knobs. REQUEST_TIMEOUT_MS is the slowloris defence:
# Fastify's own default is 0, which does not inherit Node's 300s, it disables the timeout.
# CONNECTION_TIMEOUT_MS must stay ABOVE KEEP_ALIVE_TIMEOUT_MS or it silently becomes the rule
# governing idle connections; the config schema refuses to start otherwise.
REQUEST_TIMEOUT_MS=30000
CONNECTION_TIMEOUT_MS=75000
KEEP_ALIVE_TIMEOUT_MS=72000
BODY_LIMIT_BYTES=1048576
# Granularity of REQUEST_TIMEOUT_MS: Node sweeps in-flight requests on this interval rather than
# arming a timer per request, so the effective deadline is the timeout plus up to one interval.
CONNECTIONS_CHECKING_INTERVAL_MS=5000

# Uncomment to change the docker-compose host port bindings if these clash too.
# POSTGRES_PORT=55432
# REDIS_PORT=56379
