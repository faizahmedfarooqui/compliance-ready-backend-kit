# ---------------------------------------------------------------------------
# NON-SECRET pointers only. Real credentials never live here.
# In production, secrets (DB passwords, the JWT signing key) are fetched at
# runtime from AWS KMS / Secrets Manager into typed config, never process.env.
# This file documents shape for LOCAL development only.
#
# Copy to .env at the repo root:  cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development

# The service listens here. Not 3000/3001, which collide with most dev servers.
PORT=3011

# Master (control-plane) database: tenant registry + global config.
# Ports match docker-compose.yml, which also avoids the defaults (5432/6379) so that
# `docker compose up` does not fight an existing local Postgres or Redis.
MASTER_DATABASE_URL=postgres://postgres:postgres@localhost:55432/master

# Base cluster for per-tenant databases. Each tenant gets its own database on
# this cluster; the manager appends the tenant's database name from the registry.
TENANT_CLUSTER_URL=postgres://postgres:postgres@localhost:55432

# Base URI for RFC 9457 problem `type` values; the error code is appended as a fragment.
# Dereferencing it should return documentation for the problem type, so it points at this
# repo's error catalogue. CHANGE THIS IF YOU FORK, or your API will cite someone else's docs
# for its own errors. Defaults to the upstream catalogue when unset.
PROBLEM_TYPE_BASE_URI=https://github.com/faizahmedfarooqui/compliance-ready-backend-kit/blob/main/docs/problems.md

# Auth
JWT_ISSUER=compliance-ready-backend-kit
# Rejects a token minted for some other service that happens to share these keys.
JWT_AUDIENCE=compliance-kit-api
JWT_ACCESS_TTL_SECONDS=900

# Access tokens are NESTED JWTs: the claims are signed (JWS), then that signed token is
# encrypted (JWE). That needs TWO keys, and they MUST be different: reusing one secret for
# both would mean recovering it lets an attacker forge tokens AND decrypt them.
#
# Each is a base64url-encoded 256-bit key (43 characters). Generate a fresh pair with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# DEV ONLY placeholders, and they are published in this file, so they are public knowledge.
# Never use them anywhere real. In production both keys are fetched at runtime from
# KMS / Secrets Manager and are never committed or placed in env.
JWT_SIGNING_KEY=devonly0000000000000000000000000000000000AA
JWT_ENCRYPTION_KEY=devonly0000000000000000000000000000000000BB

REDIS_URL=redis://localhost:56379

# Uncomment to change the docker-compose host port bindings if these clash too.
# POSTGRES_PORT=55432
# REDIS_PORT=56379
